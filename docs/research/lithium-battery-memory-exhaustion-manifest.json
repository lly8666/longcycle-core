    "archive_results_forbidden": true,
    "required_output_classes": [
      "obvious_landmarks",
      "long_tail_leads",
      "forgotten_actors",
      "mechanism_leads",
      "search_keys",
      "uncertain_fragments"
    ],
    "long_tail_token_share_min": 0.5
