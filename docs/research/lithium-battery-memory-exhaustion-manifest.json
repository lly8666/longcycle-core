  "recursive_questions_for_high_importance_lead": [
    "Who else? 还有哪些actor与它相关？",
    "What preceded it? 它之前有哪些先行变化？",
    "What followed it? 之后可能出现哪些行为或数据变化？",
    "What was it called then? 当时通常用什么词描述？"
  ],
  "self_verification_stage": {
    "enabled": true,
    "must_start_new_run": true,
    "source_visibility": "search_results",
    "objectives": [
      "把模糊lead变成更精确的项目名/公司名/报告名/旧称",
      "优先定位claim-scoped primary source",
      "识别转载链和独立来源簇",
      "为低成本Agent生成具体verification task packet"
    ],
    "forbidden": [
      "修改sealed blind atlas",
      "把搜索摘要直接写成Fact或Judgment",
      "因为搜不到就删除lead",
      "因为二手网页数量多就结束争议"
    ]
  },
  "saturation_rule": {
    "consecutive_low_novelty_passes": 3,
    "must_review_coverage_matrix": true,
    "must_include_long_tail_categories": [
      "forgotten_actors",
      "failure_dead_end",
      "old_vocabulary",
      "mechanism",
      "negative_space"
    ]
  }
