  "fragments": [
    {
      "fragment_key": "2018-structural-high-nickel-hydroxide-thesis",
      "document_key": "livent-2018-10k",
      "page": 18,
      "excerpt": "Automotive OEMs have announced plans to introduce longer-range EV models using higher energy density batteries, and are increasingly doing so by moving to high nickel content cathode materials. This shift will increasingly require battery-grade lithium hydroxide in the production of cathode materials.",
      "claim_context": {
        "claim_role": "management_expectation",
        "known_time": {
          "upper_bound": "2019-02-28T21:12:59Z",
          "precision": "minute",
          "basis": "SEC filing availability cross-checked by filing index redistribution"
        },
        "expectation_semantics": {
          "topic": "high-nickel cathode transition implies increasing battery-grade lithium hydroxide requirement",
          "horizon": "future structural demand growth",
          "vintage": "2018 Form 10-K"
        }
      }
    },
    {
      "fragment_key": "2019q1-demand-timing-revision",
      "document_key": "livent-2019q1-results-release",
      "excerpt": "Livent does not expect to see a meaningful change in demand for high-performance lithium hydroxide for use in high-nickel cathode chemistries until late 2019 or early 2020 and has reduced its full-year forecasts for volume and pricing accordingly.",
      "claim_context": {
        "claim_role": "management_expectation",
        "known_time": {
          "upper_bound": "2019-05-07T20:30:59Z",
          "precision": "minute",
          "basis": "PR Newswire issuer-release publication time"
        },
        "expectation_semantics": {
          "topic": "high-nickel cathode transition timing and lithium hydroxide demand",
          "horizon": "late 2019 or early 2020",
          "revision_direction": "later/weaker near-term than prior expectation"
        }
      }
    },
    {
      "fragment_key": "2019q1-customer-delay-rationale",
      "document_key": "livent-2019q1-results-release",
      "excerpt": "We are seeing weaker near-term demand for our high-performance lithium hydroxide, as several major customers have informed us about recent decisions to delay their own commercial launches of high-nickel cathode chemistries. This will result in lower delivered volumes of lithium hydroxide to these customers in 2019 than previously indicated and lower overall sales volumes for the year.",
      "claim_context": {
        "claim_role": "judgment_rationale",
        "known_time": {
          "upper_bound": "2019-05-07T20:30:59Z",
          "precision": "minute",
          "basis": "PR Newswire issuer-release publication time"
        },
        "mechanism": "customer high-nickel launch delays reduce near-term high-performance lithium hydroxide deliveries relative to prior indication"
      }
    }
