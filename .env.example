LONGCYCLE_DATABASE_URL=postgresql://longcycle:longcycle@localhost:5432/longcycle
LONGCYCLE_BLOB_BACKEND=s3
LONGCYCLE_BLOB_ROOT=.longcycle/blobs
LONGCYCLE_S3_BUCKET=longcycle-raw
LONGCYCLE_S3_ENDPOINT_URL=http://localhost:9000
LONGCYCLE_WORKER_ID=local-worker-1
LONGCYCLE_LOG_LEVEL=INFO
LONGCYCLE_EXTRACTION_SCHEMA=fact-v1

# boto3 / MinIO development credentials. Use a secret manager in production.
AWS_ACCESS_KEY_ID=longcycle
AWS_SECRET_ACCESS_KEY=longcycle-development-only
AWS_DEFAULT_REGION=us-east-1
